# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/basis_sports_dev

# API
PORT=3000
NODE_ENV=development

# CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
RBAC_ENFORCE=true

# Resend (https://resend.com/docs/api-reference/introduction)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Basis Sports <onboarding@resend.dev>"

# Frontend URL (used in password-reset email links)
APP_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=60

# Optional: set passwords for seeded admin/scout users during npm run seed
# SEED_USER_PASSWORD=Admin123!

# TypeORM (development only)
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=true